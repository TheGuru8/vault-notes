/* ---------- crypto ---------- */
async function deriveKey(password, salt){
  const enc=new TextEncoder();
  const base=await crypto.subtle.importKey('raw',enc.encode(password),'PBKDF2',false,['deriveKey']);
  return crypto.subtle.deriveKey({name:'PBKDF2',salt,iterations:120000,hash:'SHA-256'},base,{name:'AES-GCM',length:256},false,['encrypt','decrypt']);
}
async function encryptStr(plaintext, password){
  const salt=crypto.getRandomValues(new Uint8Array(16));
  const iv=crypto.getRandomValues(new Uint8Array(12));
  const key=await deriveKey(password,salt);
  const enc=new TextEncoder();
  const ct=await crypto.subtle.encrypt({name:'AES-GCM',iv},key,enc.encode(plaintext));
  return {salt:buf2b64(salt), iv:buf2b64(iv), data:buf2b64(new Uint8Array(ct))};
}
async function decryptStr(pack, password){
  const salt=b642buf(pack.salt), iv=b642buf(pack.iv), data=b642buf(pack.data);
  const key=await deriveKey(password,salt);
  const pt=await crypto.subtle.decrypt({name:'AES-GCM',iv},key,data);
  return new TextDecoder().decode(pt);
}
function buf2b64(buf){ return btoa(String.fromCharCode(...new Uint8Array(buf))); }
function b642buf(b64){ return Uint8Array.from(atob(b64),c=>c.charCodeAt(0)); }

/* ---------- app lock ---------- */
async function initAppLock(){
  const overlay = document.getElementById('appLockOverlay');
  if(state.pinConfig && state.pinConfig.hash){
    overlay.classList.remove('hidden');
    document.getElementById('appPinUnlockBtn').onclick = checkAppPin;
    document.getElementById('appPinInput').onkeydown = e => { if(e.key === 'Enter') checkAppPin(); };
  } else {
    overlay.classList.add('hidden');
  }
}

async function hashPin(pin, salt){
  const enc = new TextEncoder();
  const keyData = enc.encode(pin + salt);
  const hashBuffer = await crypto.subtle.digest('SHA-256', keyData);
  return buf2b64(hashBuffer);
}

async function checkAppPin(){
  const input = document.getElementById('appPinInput');
  const val = input.value;
  if(!val) return;
  const h = await hashPin(val, state.pinConfig.salt);
  if(h === state.pinConfig.hash){
    document.getElementById('appLockOverlay').classList.add('hidden');
    input.value = '';
    resetInactivityTimer();
  } else {
    toast('Incorrect PIN/Password');
    input.value = '';
    input.focus();
  }
}

function openAppLockSettingsModal(){
  if(state.pinConfig && state.pinConfig.hash){
    showModal('App Lock Controls', [
      {id:'oldPin', ph:'Current PIN/Password', type:'password'}
    ], async vals => {
      const h = await hashPin(vals.oldPin, state.pinConfig.salt);
      if(h !== state.pinConfig.hash){
        toast('Incorrect current PIN/Password');
        return false;
      }
      if(confirm('Do you want to disable the App Lock PIN?')){
        state.pinConfig = null;
        save();
        toast('App Lock removed');
        renderSide();
        return true;
      }
    });
  } else {
    showModal('Enable App Lock', [
      {id:'p1', ph:'Set PIN/Password (4+ chars)', type:'password'},
      {id:'p2', ph:'Confirm PIN/Password', type:'password'}
    ], async vals => {
      if(!vals.p1 || vals.p1.length < 4){ toast('PIN must be at least 4 characters'); return false; }
      if(vals.p1 !== vals.p2){ toast('PINs do not match'); return false; }
      const salt = buf2b64(crypto.getRandomValues(new Uint8Array(16)));
      const hash = await hashPin(vals.p1, salt);
      state.pinConfig = { salt, hash };
      save();
      toast('App Lock enabled');
      resetInactivityTimer();
      renderSide();
      return true;
    });
  }
}

/* ---------- markdown ---------- */
function mdToHtml(src){
  let h=esc(src);
  h=h.replace(/```([\s\S]*?)```/g,(m,c)=>'<pre><code>'+c.trim()+'</code></pre>');
  h=h.replace(/`([^`]+)`/g,'<code>$1</code>');
  h=h.replace(/^### (.*)$/gm,'<h3>$1</h3>').replace(/^## (.*)$/gm,'<h2>$1</h2>').replace(/^# (.*)$/gm,'<h1>$1</h1>');
  h=h.replace(/\*\*(.+?)\*\*/g,'<b>$1</b>').replace(/\*(.+?)\*/g,'<i>$1</i>');
  h=h.replace(/^-\s(.*)$/gm,'<li>$1</li>');
  h=h.replace(/(<li>[\s\S]*?<\/li>)/g,'<ul>$1</ul>');
  h=h.split(/\n{2,}/).map(p=>/^<(h1|h2|h3|ul|pre)/.test(p.trim())?p:'<p>'+p.replace(/\n/g,'<br>')+'</p>').join('');
  return h;
}

/* ---------- note sorting & filtering ---------- */
function visibleNotes(){
  return state.notes.filter(n=>{
    if(showBin) return n.deleted;
    if(n.deleted) return false;
    if(currentTag && !(n.tags||[]).includes(currentTag)) return false;
    if(currentFolder!=='__all' && n.folder!==currentFolder) return false;
    
    if(titleSearchQuery.trim().length > 0){
      const q = titleSearchQuery.toLowerCase().trim();
      const titleToMatch = n.locked ? (unlockedCache[n.id]?.title || '') : (n.title || '');
      if(!titleToMatch.toLowerCase().includes(q)) return false;
    }
    return true;
  }).sort((a,b)=>{
    if(!showBin){
      if(a.pinned && !b.pinned) return -1;
      if(!a.pinned && b.pinned) return 1;
    }
    if(currentSortMode==='created') return b.createdAt - a.createdAt;
    if(currentSortMode==='title'){
      const tA = (a.title||'').toLowerCase();
      const tB = (b.title||'').toLowerCase();
      return tA.localeCompare(tB);
    }
    return b.updatedAt - a.updatedAt;
  });
}

