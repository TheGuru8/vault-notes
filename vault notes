      <button id="resetBgColorBtn" title="Remove fill/highlight color">⌫H</button>
    </div>
    <div class="tb-grp">
      <select id="caseSelect" title="Change Text Case">
        <option value="">aA Case</option>
        <option value="upper">UPPERCASE</option>
        <option value="lower">lowercase</option>
        <option value="title">Capitalize Each Word</option>
        <option value="sentence">Sentence case</option>
      </select>
      <button id="quoteMarkBtn" title="Insert Smart Quotes">“ ”</button>
      <button id="linkBtn" title="Insert Link">🔗</button>
    </div>
    <div class="tb-grp">
      <button data-cmd="insertUnorderedList" title="Bullet List">• List</button>
      <button data-cmd="insertOrderedList" title="Numbered List">1. List</button>
      <button id="checklistBtn" title="Checklist">☑</button>
    </div>
    <div class="tb-grp">
      <button id="codeBtn" title="Code Block">&lt;/&gt;</button>
      <button id="imgBtn" title="Insert Image">🖼</button>
    </div>
    ${n.locked?'':'<div class="tb-grp"><button id="mdToggle" class="'+(n.isMarkdown?'on':'')+'">Markdown</button></div>'}`;

  const findBar = `
    <div class="find-bar ${isFindBarOpen?'':'hidden'}" id="findBar">
      <span>Find:</span><input type="text" id="findInput">
      <span>Replace:</span><input type="text" id="replaceInput">
      <button id="btnReplace">Replace</button>
      <button id="btnReplaceAll">Replace All</button>
      <span class="close-find" id="closeFindBtn">✕</span>
    </div>`;

  return '<div class="toolbar"><button class="back" onclick="mobileShow(\'list\')">‹ Back</button>'+tb+
    '<div class="tb-grp">'+
      '<button id="printBtn" title="Print / Export PDF">🖨️</button>'+
      '<button id="lockBtn" title="Lock Note">'+(n.locked?'🔓 Unlock':'🔒 Lock')+'</button>'+
      '<button id="roBtn" title="Toggle Read-Only">'+(n.readonly?'🔒 Editable':'🔒 Read-only')+'</button>'+
      '<button id="moveBtn" title="Move / Copy">📁</button>'+
      '<button id="trashBtn" title="Delete Note">🗑</button>'+
    '</div>'+
    '<span class="saveStatus" id="saveStatus">Saved</span></div>'+
    findBar+
    '<div class="editor-head"><input class="title" id="titleInput" value="'+esc(dispTitle||'')+'" placeholder="Untitled" '+(n.readonly?'disabled':'')+'></div>'+
    '<div class="editor-meta">'+
      '<select id="folderSelect">'+state.folders.map(f=>'<option '+(f===n.folder?'selected':'')+'>'+esc(f)+'</option>').join('')+'</select>'+
      '<input class="tags" id="tagsInput" list="tagSuggestions" placeholder="tags, comma separated" value="'+esc((dispTags||[]).join(', '))+'" '+(n.readonly?'disabled':'')+'>'+
    '</div>'+
    '<div class="editor-body" id="editorBody">'+
      (n.isMarkdown
        ? '<textarea class="mdsrc" id="mdSrc" data-ph="Write markdown…" '+(n.readonly?'disabled':'')+'>'+esc(n.mdSrc||'')+'</textarea>'
        : '<div class="content" id="content" data-ph="Start writing…" '+disabled+'>'+(dispHtml||'')+'</div>')+
    '<input type="file" id="imgFile" accept="image/*" class="filehide"></div>'+
    '<div class="scroll-nav">'+
      '<button id="scrollTopBtn" title="Scroll to top">↑</button>'+
      '<button id="scrollBottomBtn" title="Scroll to bottom">↓</button>'+
    '</div>'+
    '<div class="editor-footer">'+
      '<span id="wordCount">0 words</span> · <span id="charCount">0 characters</span>'+
      '<span id="readTime">1 min read</span>'+
    '</div>';
}

function updateWordStats() {
  const content = document.getElementById('content');
  const mdSrc = document.getElementById('mdSrc');
  let text = '';
  if (content) text = content.textContent || '';
  else if (mdSrc) text = mdSrc.value || '';

  const trimmed = text.trim();
  const words = trimmed ? trimmed.split(/\s+/).length : 0;
  const chars = text.length;
  const readMins = Math.max(1, Math.ceil(words / 200));

  const wcEl = document.getElementById('wordCount');
  const ccEl = document.getElementById('charCount');
  const rtEl = document.getElementById('readTime');

  if (wcEl) wcEl.textContent = `${words} words`;
  if (ccEl) ccEl.textContent = `${chars} characters`;
  if (rtEl) rtEl.textContent = `~${readMins} min read`;
}

function updateTagSuggestions(currentInputVal) {
  const datalist = document.getElementById('tagSuggestions');
  if(!datalist) return;
  datalist.innerHTML = '';
  const allExistingTags = allTags();
  const parts = currentInputVal.split(',').map(s=>s.trim());
  const alreadyUsedTags = parts.slice(0, -1);

  allExistingTags.forEach(tag => {
    if(!alreadyUsedTags.includes(tag)) {
      const opt = document.createElement('option');
      opt.value = alreadyUsedTags.length > 0 ? alreadyUsedTags.join(', ') + ', ' + tag : tag;
      datalist.appendChild(opt);
    }
  });
}

function bindEditor(n){
  updateWordStats();
  
  const content = document.getElementById('content');
  if(content){
    content.addEventListener('keyup', preserveSelection);
    content.addEventListener('mouseup', preserveSelection);
    content.addEventListener('touchend', preserveSelection);
    content.oninput = () => { saveContent(); updateWordStats(); };
  }

  const printBtn = document.getElementById('printBtn');
  if (printBtn) printBtn.onclick = () => window.print();

  const titleInput=document.getElementById('titleInput');
  titleInput.oninput=()=>{
    if(n.locked){ unlockedCache[n.id].title=titleInput.value; reEncryptLocked(n); }
    else { n.title=titleInput.value; n.updatedAt=Date.now(); commit(n); }
    renderList(); flashSaved();
  };
  
  const folderSelect=document.getElementById('folderSelect');
  folderSelect.onchange=()=>{ n.folder=folderSelect.value; n.updatedAt=Date.now(); save(); renderAll(); };
  
  const tagsInput=document.getElementById('tagsInput');
  if(tagsInput){
    updateTagSuggestions(tagsInput.value);
    tagsInput.oninput=()=>{
      updateTagSuggestions(tagsInput.value);
      const tags=tagsInput.value.split(',').map(t=>t.trim()).filter(Boolean);
      if(n.locked){ unlockedCache[n.id].tags=tags; reEncryptLocked(n); }
      else { n.tags=tags; commit(n); }
      renderSide(); flashSaved();
    };
  }

  document.querySelectorAll('.toolbar [data-cmd]').forEach(b=>{
    b.onclick=()=>{
      restoreSelection();
      document.execCommand(b.dataset.cmd,false,null);
      saveContent();
    };
  });

  /* Scroll to Top and Bottom Navigation */
  const editorBody = document.getElementById('editorBody');
  const scrollTopBtn = document.getElementById('scrollTopBtn');
  const scrollBottomBtn = document.getElementById('scrollBottomBtn');

  if (scrollTopBtn && editorBody) {
    scrollTopBtn.onclick = () => {
      editorBody.scrollTo({ top: 0, behavior: 'smooth' });
    };
  }

  if (scrollBottomBtn && editorBody) {
    scrollBottomBtn.onclick = () => {
      editorBody.scrollTo({ top: editorBody.scrollHeight, behavior: 'smooth' });
    };
  }

  /* Block Level Styling */
  const blockStyle = document.getElementById('blockStyle');
  if (blockStyle) {
    blockStyle.onchange = () => {
      restoreSelection();
      document.execCommand('formatBlock', false, blockStyle.value);
      saveContent();
    };
  }

  /* Numeric Font Size Selector */
  const fontSizeSelect = document.getElementById('fontSizeSelect');
  if (fontSizeSelect) {
    fontSizeSelect.onchange = () => {
      const size = fontSizeSelect.value;
      if (!size) return;
      applyCustomStyle('fontSize', size);
      fontSizeSelect.value = "";
      saveContent();
    };
  }

  /* Text and Fill Color Pickers */
  const handleTextColor = (val) => {
    document.getElementById('colorPrev').style.background = val;
    applyCustomStyle('color', val);
    saveContent();
  };
  const textColor = document.getElementById('textColor');
  if (textColor) {
    textColor.oninput = () => handleTextColor(textColor.value);
    textColor.onchange = () => handleTextColor(textColor.value);
  }

  const handleBgColor = (val) => {
    document.getElementById('bgColorPrev').style.background = val;
    applyCustomStyle('backgroundColor', val);
    saveContent();
  };
  const bgColor = document.getElementById('bgColor');
  if (bgColor) {
    bgColor.oninput = () => handleBgColor(bgColor.value);
    bgColor.onchange = () => handleBgColor(bgColor.value);
  }

  const resetTextColorBtn = document.getElementById('resetTextColorBtn');
  if (resetTextColorBtn) resetTextColorBtn.onclick = () => {
    document.getElementById('colorPrev').style.background = '#15181c';
    applyCustomStyle('color', '#15181c');
    saveContent();
  };
  const resetBgColorBtn = document.getElementById('resetBgColorBtn');
  if (resetBgColorBtn) resetBgColorBtn.onclick = () => {
    document.getElementById('bgColorPrev').style.background = 'transparent';
    applyCustomStyle('backgroundColor', 'transparent');
    saveContent();
  };

  /* Case Transformation Dropdown */
  const caseSelect = document.getElementById('caseSelect');
  if (caseSelect) {
    caseSelect.onchange = () => {
      const val = caseSelect.value;
      if (val) {
        changeTextCase(val);
        caseSelect.value = "";
        saveContent();
      }
    };
  }

  /* Quote Mark Button */
  const quoteMarkBtn = document.getElementById('quoteMarkBtn');
  if (quoteMarkBtn) {
    quoteMarkBtn.onclick = () => {
      restoreSelection();
      const sel = window.getSelection();
      const selectedText = sel.toString();
      document.execCommand('insertText', false, `“${selectedText}”`);
      saveContent();
    };
  }

  /* Link Button */
  const linkBtn = document.getElementById('linkBtn');
  if (linkBtn) {
    linkBtn.onclick = () => {
      restoreSelection();
      const url = prompt("Enter hyperlink URL:", "https://");
      if (url) {
        document.execCommand('createLink', false, url);
        saveContent();
      }
    };
  }

  const checklistBtn=document.getElementById('checklistBtn');
  if(checklistBtn) checklistBtn.onclick=()=>{
    restoreSelection();
    const selText = window.getSelection().toString();
    document.execCommand('insertHTML', false, '<ul class="checklist"><li>'+esc(selText)+'</li></ul>');
    saveContent();
  };

  const imgBtn=document.getElementById('imgBtn');
  if(imgBtn) imgBtn.onclick=()=>document.getElementById('imgFile').click();
  const imgFile=document.getElementById('imgFile');
  if(imgFile) imgFile.onchange=()=>{
    restoreSelection();
    const f=imgFile.files[0]; if(!f) return;
    const r=new FileReader();
    r.onload=()=>{ document.execCommand('insertImage',false,r.result); saveContent(); };
    r.readAsDataURL(f);
  };

  const mdSrc=document.getElementById('mdSrc');
  if(mdSrc) mdSrc.oninput=()=>{ 
    n.mdSrc=mdSrc.value; n.updatedAt=Date.now(); commit(n); renderList(); flashSaved(); updateWordStats();
  };

  function saveContent(){
    if(n.readonly) return;
    const html=document.getElementById('content').innerHTML;
    if(n.locked){ unlockedCache[n.id].html=html; reEncryptLocked(n); }
    else { n.html=html; n.updatedAt=Date.now(); commit(n); }
    renderList(); flashSaved();
  }

  function flashSaved(){
    const s=document.getElementById('saveStatus'); if(!s) return;
    s.textContent='Saving…';
    clearTimeout(window._sv);
    window._sv=setTimeout(()=>{ s.textContent='Saved'; },400);
  }

  document.getElementById('lockBtn').onclick=()=>openLockModal(n);
  document.getElementById('moveBtn').onclick=()=>openMoveCopyModal(n);
  document.getElementById('roBtn').onclick=()=>{ n.readonly=!n.readonly; commit(n); renderEditor(); };
  document.getElementById('trashBtn').onclick=()=>{ n.deleted=true; currentNoteId=null; commit(n); toast('Moved to recycle bin'); renderAll(); };
}

function commit(n){ n.updatedAt=n.updatedAt||Date.now(); save(); }

/* ---------- modals & global events ---------- */
function openLockModal(n){
  if(n.locked){
    if(confirm('Remove lock from this note?')){
      const uc=unlockedCache[n.id]||{title:'',tags:[],html:''};
      n.title=uc.title; n.tags=uc.tags; n.html=uc.html; n.locked=false; n.encrypted=null;
      delete unlockedCache[n.id]; delete unlockedPw[n.id];
      commit(n); toast('Lock removed'); renderAll();
    }
    return;
  }
  showModal('Lock note', [{id:'pw1',ph:'Password (8+ chars)',type:'password'},{id:'pw2',ph:'Confirm password',type:'password'}], async vals=>{
    if(!vals.pw1 || vals.pw1.length<MIN_PW_LEN){ toast('Password must be at least '+MIN_PW_LEN+' chars'); return false; }
    if(vals.pw1!==vals.pw2){ toast('Passwords do not match'); return false; }
    const content = n.isMarkdown ? mdToHtml(n.mdSrc||'') : (n.html||'');
    const cache = {title:n.title||'', tags:n.tags||[], html:content};
    n.encrypted = await encryptStr(JSON.stringify(cache), vals.pw1);
    n.title=''; n.tags=[]; n.html=''; n.mdSrc=''; n.locked=true;
    unlockedCache[n.id]=cache; unlockedPw[n.id]=vals.pw1;
    commit(n); toast('Note locked'); renderAll(); return true;
  });
}

function openMoveCopyModal(n){
  const bg=document.createElement('div'); bg.className='modal-bg';
  bg.innerHTML='<div class="modal"><h3>Move or copy note</h3>'+
    '<select id="mcFolder">'+state.folders.map(f=>'<option '+(f===n.folder?'selected':'')+'>'+esc(f)+'</option>').join('')+'</select>'+
    '<div class="row"><button class="ghost" id="mcCancel">Cancel</button><button class="primary" id="mcMove">Move</button></div></div>';
  document.body.appendChild(bg);
  bg.querySelector('#mcCancel').onclick=()=>bg.remove();
  bg.querySelector('#mcMove').onclick=()=>{
    n.folder=bg.querySelector('#mcFolder').value; n.updatedAt=Date.now(); save(); toast('Moved'); bg.remove(); renderAll();
  };
}

function showModal(title, fields, onOk){
  const bg=document.createElement('div'); bg.className='modal-bg';
  bg.innerHTML='<div class="modal"><h3>'+esc(title)+'</h3>'+
    fields.map(f=>'<input id="mf_'+f.id+'" type="'+(f.type||'text')+'" placeholder="'+esc(f.ph)+'">').join('')+
    '<div class="row"><button class="ghost" id="mCancel">Cancel</button><button class="primary" id="mOk">OK</button></div></div>';
  document.body.appendChild(bg);
  bg.querySelector('#mCancel').onclick=()=>bg.remove();
  bg.querySelector('#mOk').onclick=async()=>{
    const vals={}; fields.forEach(f=>vals[f.id]=bg.querySelector('#mf_'+f.id).value);
    const ok=await onOk(vals); if(ok!==false) bg.remove();
  };
}

document.getElementById('newNoteBtn').onclick=createNewNote;
document.getElementById('quickAddBtn').onclick=createNewNote;
document.getElementById('appLockSettingsBtn').onclick=openAppLockSettingsModal;
document.getElementById('titleSearchInput').oninput=(e)=>{ titleSearchQuery = e.target.value; renderList(); };
document.getElementById('sortSelect').onchange=(e)=>{ currentSortMode = e.target.value; renderList(); };
document.getElementById('batchDeleteBtn').onclick=handleBatchDelete;
document.getElementById('batchMoveBtn').onclick=handleBatchMove;

document.getElementById('addFolderBtn').onclick=()=>{
  showModal('New folder',[{id:'name',ph:'Folder name'}],vals=>{
    if(!vals.name) return false;
    if(!state.folders.includes(vals.name)) state.folders.push(vals.name);
    save(); renderSide();
  });
};
document.getElementById('binItem').onclick=()=>{ showBin=true; currentTag=null; selectedNoteIds.clear(); renderAll(); if(window.innerWidth<=820) mobileShow('list'); };

document.getElementById('backToSide') && (document.getElementById('backToSide').onclick=()=>mobileShow('side'));

function renderAll(){ renderSide(); renderList(); renderEditor(); if(window.innerWidth<=820 && !currentNoteId) mobileShow('list'); }

// Initial state setup for mobile browser history navigation
if (window.innerWidth <= 820) {
  history.replaceState({ pane: 'side' }, '');
}

initAppLock();
renderAll();
</script>
